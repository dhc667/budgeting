# Copy to .env.owner (git-ignored) and fill in from your Supabase project.
# Never commit .env.owner: the secret key and database URL give full access to your family's data.

# Where the app is hosted.
APP_URL=https://dhc667.github.io/budgeting/

# Project Settings > API Keys, or `pnpm exec supabase projects api-keys --project-ref <ref> --reveal`.
# The publishable key ends up in every QR code; the secret key never leaves this machine.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Connect > Session pooler (the direct connection is IPv6-only), with the database password filled in.
# Copy the host rather than guessing it, and keep sslmode=require: without it the connection is unencrypted.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
