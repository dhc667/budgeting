{
  "name": "budgeting",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "prepare": "git config core.hooksPath .githooks",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm translations && pnpm test",
    "fix": "prettier --write --cache --cache-location .cache/prettier . && eslint --fix .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc -b",
    "knip": "knip",
    "translations": "i18next-cli status && i18next-cli status --unused",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:start": "supabase start && scripts/write-local-env.sh && node cli/instance.ts migrate --env .env.instance.local",
    "db:stop": "supabase stop",
    "db:generate": "drizzle-kit generate",
    "db:types": "supabase gen types typescript --local --schema public > src/supabase/database.types.ts",
    "instance": "node cli/instance.ts",
    "app": "node cli/app.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.2",
    "i18next": "^26.4.4",
    "idb": "^8.0.4",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inquirer/prompts": "^8.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "i18next-cli": "^1.75.3",
    "jsdom": "^30.1.2",
    "knip": "^6.41.0",
    "postgres": "^3.4.9",
    "prettier": "^3.9.10",
    "qrcode-terminal": "^0.12.0",
    "supabase": "^2.120.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4",
    "zod": "^4.6.7"
  }
}
